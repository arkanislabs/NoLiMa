# Copy this file to .env (`cp .env.example .env`) and fill in the keys you need.
# .env is git-ignored. Never commit real keys.
#
# Model configs in evaluation/model_configs reference these with ${VAR_NAME},
# e.g. "api_key": "${OPENROUTER_API_KEY}". Variables already exported in your
# shell take precedence over values in .env.

# OpenRouter (https://openrouter.ai/keys), used by llama_3.3_70b_openrouter.json
OPENROUTER_API_KEY=

# Hugging Face token, needed to download gated tokenizers (e.g. meta-llama/*)
# when tokenizer_type is "huggingface". Read by transformers automatically.
HF_TOKEN=

# Azure OpenAI, used by gpt_4o_20241120.json and gpt_4.1_20250414.json
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/

# AWS Bedrock (aws provider). Read by boto3 automatically.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Google Vertex AI (gemini provider). Path to a service account key file;
# alternatively run `gcloud auth application-default login`.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
